# syntax=docker/dockerfile:1
# The scratch host image: the broker, the QEMU userland it spawns, and the
# golden guest artifacts the microVM boots. Everything is built into a single
# image to pin kernel, userspace, and tooling as a single digest. COS hosts
# docker-run this image (privileged, host net, /dev/kvm) and the entrypoint
# stages the guest artifacts onto the host's disk.

FROM golang:1.26-alpine AS binary
ARG DEBUG=false
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build \
    -ldflags="$([ ${DEBUG} = "true" ] || printf '-s -w')" \
    -gcflags="-l=4" \
    -o scratch-host \
    ./cmd/scratch-host

# Guest kernel: the Debian cloud kernel, unpacked rather than installed so no
# postinst tries to configure a bootloader, plus an initrd with the virtio
# modules the microvm machine needs to reach the rootfs. ext4 is built in.
FROM debian:13-slim AS kernel
ENV DEBIAN_FRONTEND=noninteractive
RUN <<EOF
 set -eux
 apt-get update -qq
 apt-get install -qq -y --no-install-recommends initramfs-tools kmod zstd

 # linux-image-cloud-amd64 is a metapackage. Resolve it to the versioned
 # image, which carries its modules.
 kpkg=$(apt-cache depends linux-image-cloud-amd64 | sed -n 's/ *Depends: \(linux-image-.*\)/\1/p' | head -1)
 kver=${kpkg#linux-image-}
 cd /tmp
 apt-get download -qq "$kpkg"
 mkdir /x
 for deb in *.deb; do dpkg-deb -x "$deb" /x; done
 moddir=/x/usr/lib/modules
 [ -d "$moddir" ] || moddir=/x/lib/modules

 # mkinitramfs wants the module tree installed where depmod looks.
 mkdir -p /usr/lib/modules
 cp -a "$moddir/$kver" /usr/lib/modules/
 depmod -a "$kver"
 conf=$(mktemp -d)
 cp -a /etc/initramfs-tools/. "$conf/"
 sed -i 's/^MODULES=.*/MODULES=list/' "$conf/initramfs.conf"
 printf 'virtio_mmio\nvirtio_blk\nvirtio_net\nvirtio_rng\n' > "$conf/modules"

 mkdir /out
 mkinitramfs -d "$conf" -o /out/initrd.img "$kver"
 cp "/x/boot/vmlinuz-$kver" /out/vmlinuz
 cp -a "$moddir" /out/modules
 echo "$kver" > /out/kernel-version.txt
EOF

# Golden guest rootfs. Not intended to be run as a container but is flattened
# into a rootfs.raw. No repo binaries are included. The broker reaches in over
# ssh, authorized by the key delivered on the kernel command line. The tree
# under build/package/scratch-host-guest/ supplies the boot units that
# configure eth0 and root's authorized_keys from /proc/cmdline, the sshd,
# docker and mount configuration, and the tmpfiles rule behind /home/builder.
# udev is what lets systemd see /dev/vdb so docker can start.
FROM debian:13-slim AS guest
ENV DEBIAN_FRONTEND=noninteractive
RUN <<EOF
 set -eux
 apt-get update
 apt-get install -y --no-install-recommends \
     systemd-sysv udev dbus openssh-server ca-certificates curl gnupg \
     iproute2 iptables kmod e2fsprogs procps xz-utils
 rm -rf /var/lib/apt/lists/*
EOF
# docker-ce from the upstream repo, so the guest daemon tracks Docker's
# releases rather than the base release's docker.io. daemon.json roots the
# image store on the scratch disk instead of the default /var/lib/docker and
# selects the containerd snapshotter.
ARG DOCKER_APT_SUITE=trixie
RUN <<EOF
 set -eux
 install -m 0755 -d /etc/apt/keyrings
 curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
 echo "deb [signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian ${DOCKER_APT_SUITE} stable" \
     > /etc/apt/sources.list.d/docker.list
 apt-get update
 apt-get install -y --no-install-recommends docker-ce docker-ce-cli containerd.io docker-buildx-plugin
 rm -rf /var/lib/apt/lists/*
EOF
COPY build/package/scratch-host-guest/ /
RUN <<EOF
 set -eux
 # Build state lives on the scratch disk. The home is a symlink there, and
 # a tmpfiles rule creates the target at boot.
 useradd --no-create-home --home-dir /home/builder --shell /bin/bash builder
 usermod -aG docker builder
 ln -s /scratch/home /home/builder

 # Boot units. microvm-net configures eth0 so no wait required.
 systemctl enable containerd docker ssh microvm-net microvm-authkey
 systemctl mask systemd-networkd-wait-online systemd-networkd systemd-resolved \
     apt-daily.timer apt-daily-upgrade.timer e2scrub_all.timer
 # Host keys at build time so first boot does not pay for them. Every
 # guest shares them: the bridge is host-local and the per-guest
 # authorized key is the auth boundary.
 ssh-keygen -A
 # Empty, so systemd generates a fresh machine-id per guest on first boot.
 : > /etc/machine-id
EOF

# Pack the guest into rootfs.raw with mkfs.ext4 -d: no loop devices, no
# privileges. Its own stage so the packing tools and the kernel image stay
# out of the guest tree.
FROM debian:13-slim AS pack
RUN apt-get update && apt-get install -y --no-install-recommends e2fsprogs kmod && rm -rf /var/lib/apt/lists/*
COPY --from=guest / /rootfs
COPY --from=kernel /out /kout
RUN <<EOF
 set -eux
 # Docker bind-mounts these three during a build, so nothing written to
 # them in the guest stage reached its layer. microvm-net rewrites them at
 # boot from the kernel command line.
 echo 'nameserver 8.8.8.8' > /rootfs/etc/resolv.conf
 echo guest > /rootfs/etc/hostname
 echo '127.0.0.1 localhost' > /rootfs/etc/hosts

 # Baseline device nodes for early userspace. devtmpfs takes over once the
 # kernel is up.
 for spec in 'null 1 3' 'zero 1 5' 'random 1 8' 'urandom 1 9' 'console 5 1'; do
     set -- $spec
     [ -e "/rootfs/dev/$1" ] || mknod -m 666 "/rootfs/dev/$1" c "$2" "$3"
 done
 chmod 600 /rootfs/dev/console

 # Module tree for the kernel this same build produced.
 kver=$(cat /kout/kernel-version.txt)
 mkdir -p /rootfs/usr/lib/modules
 cp -a "/kout/modules/$kver" /rootfs/usr/lib/modules/
 depmod -a -b /rootfs "$kver"

 # Root holds only the system, since build state lives on the scratch disk.
 # The headroom covers what a session writes outside /scratch.
 size_mb=$(( $(du -sm /rootfs | cut -f1) + 512 ))
 mkdir /golden
 mke2fs -q -F -t ext4 -m 0 -d /rootfs /golden/rootfs.raw "${size_mb}M"
 e2fsck -fn /golden/rootfs.raw

 # The image holds what the host contract and the boot chain expect.
 debugfs -R 'stat /usr/local/sbin/microvm-authkey' /golden/rootfs.raw 2>&1 | grep -q 'Type: regular'
 debugfs -R "ls /usr/lib/modules/$kver/kernel" /golden/rootfs.raw 2>&1 | grep -q drivers
 debugfs -R 'stat /etc/systemd/system/multi-user.target.wants/docker.service' /golden/rootfs.raw 2>&1 | grep -q 'Type: symlink'
 debugfs -R 'stat /home/builder' /golden/rootfs.raw 2>&1 | grep -q 'Type: symlink'
 cp /kout/vmlinuz /kout/initrd.img /golden/
EOF

FROM debian:13-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    qemu-system-x86 qemu-utils iproute2 e2fsprogs ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=pack /golden /golden
COPY --from=binary /src/scratch-host /scratch-host
COPY build/package/scratch-host-entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
