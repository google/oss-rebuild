{{define "content"}}
<!--
 Copyright 2026 Google LLC
 SPDX-License-Identifier: Apache-2.0
-->

<style>
    .showing { color: var(--muted); font-size: 0.9rem; margin: 0 0 8px; }
    .pkg-stats { display: inline-flex; align-items: center; gap: 10px; margin-left: auto; color: var(--muted); font-size: 0.85rem; white-space: nowrap; }
    .pkg-sub { padding-left: 0; }
    .why { flex: 1 1 18em; display: flex; align-items: center; gap: 8px; min-width: 0; }
    .streak { flex: none; width: 9em; text-align: right; color: var(--mismatch); font-size: 0.85rem; font-weight: 600; }
    @media (max-width: 640px) {
        .pkg-head, .pkg-sub { flex-wrap: wrap; }
        .pkg-stats { order: 1; flex-basis: 100%; margin-left: 0; }
        .streak { width: auto; margin-left: auto; }
        .pkg-sub .row-end { flex-shrink: 1; white-space: normal; text-align: right; }
    }
</style>
<h2>Packages</h2>
{{if not .Loaded}}
<p>No analytics snapshot loaded. Start the dashboard with
<code>-rundex=&lt;gs://…|file://…&gt;</code>.</p>
{{else}}
<p class="asof">Snapshot as of {{.AsOf}}</p>
<div class="tabs">
    <a class="tab{{if not .Eco}} active{{end}}" href="/packages">All</a>
    {{$sel := .Eco}}
    {{range .Ecosystems}}<a class="tab{{if eq . $sel}} active{{end}}" href="/packages?eco={{.}}">{{.}}</a>
    {{end}}
</div>
<div class="band">
    <section class="card band-main">
        <div class="eyebrow">Ever built{{template "def" "Reproduced at least one version."}}</div>
        <div class="hero-figure">{{num .EverBuilt}}</div>
        <div class="hero-sub">of {{num .Total}} packages attempted{{template "def" "Packages with at least one completed attempt."}}, <b>{{num .NeverBuilt}}</b> never built</div>
        <div class="segbar" data-title="{{if .Eco}}{{.Eco}}{{else}}All ecosystems{{end}}">
            {{- if .EverBuilt}}<span class="seg ok" style="flex-grow: {{.EverBuilt}}" data-c="ok" data-v="{{num .EverBuilt}}" data-k="ever built"></span>{{end}}
            {{- if .NeverBuilt}}<span class="seg bad" style="flex-grow: {{.NeverBuilt}}" data-c="bad" data-v="{{num .NeverBuilt}}" data-k="never built"></span>{{end -}}
        </div>
        <div class="legend">
            <span class="legend-item"><i class="swatch ok"></i>Ever built</span>
            <span class="legend-item"><i class="swatch bad"></i>Never built</span>
        </div>
    </section>
    <section class="card">
        <div class="chart-title">Failing streak{{template "def" "Completed builds since the last success on any version, or every build when none succeeded."}}</div>
        <div class="chart-sub"><b>{{num .Failing}}</b> packages whose latest builds failed, by how many in a row</div>
        <div class="chart" data-chart="hist" data-src="streaks" data-h="150" data-unit="failed builds in a row" data-label="packages"></div>
    </section>
</div>
<script type="application/json" id="streaks">{{.Streaks}}</script>
{{if not .Packages}}
<p>No packages recorded in the snapshot.</p>
{{else}}
<p class="showing">Showing {{num .Listed}} of {{num .Total}}, longest failing streak first.{{template "def" "The bars are the latest completed builds, oldest first. Successes rise above the line and failures drop below it. The streak counts completed builds since the last success, on any version."}}</p>
<ul class="rows">
    {{- range .Packages}}
    <li class="row">
        <div class="row-head pkg-head">
            <a class="row-name" href="/package/{{.EncodedEcosystem}}/{{.EncodedPackage}}">{{.Package}}</a>
            {{- if not $.Eco}}<span class="tag">{{.Ecosystem}}</span>{{end}}
            <span class="pkg-stats">{{.VersionsSucceeded}} of {{.VersionsAttempted}} versions built · {{num .Attempts}} attempts<span class="beads">{{range .Recent}}<i{{if .}} class="ok"{{end}}></i>{{end}}</span></span>
            <span class="streak">{{if .FailingStreak}}{{.FailingStreak}} failed in a row{{end}}</span>
        </div>
        <div class="row-sub pkg-sub">
            {{- with .LastFailure}}<span class="why">{{with stage .}}<span class="stage">{{.}}</span>{{end}}<span class="cause" title="{{.}}" tabindex="0">{{cause .}}</span></span>{{end}}
            <span class="row-end">{{if .LastSucceededVersion}}built {{.LastSucceededVersion}} on {{.LastSucceededAt}} · {{end}}tried {{.LastAttemptedVersion}} on {{.LastAttemptedAt}}</span>
        </div>
    </li>
    {{- end}}
</ul>
{{end}}
{{end}}
{{end}}
