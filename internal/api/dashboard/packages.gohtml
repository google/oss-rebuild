{{define "def"}}<span class="info" tabindex="0" data-tip="{{.}}">?</span>{{end}}
{{define "content"}}
<!--
 Copyright 2026 Google LLC
 SPDX-License-Identifier: Apache-2.0
-->

<style>
    .showing { color: var(--muted); font-size: 0.9rem; margin: 0 0 8px; }
    .streak { color: var(--mismatch); font-weight: 600; }
</style>
<h2>Packages</h2>
{{if not .Loaded}}
<p>No analytics snapshot loaded. Start the dashboard with
<code>-rundex=&lt;gs://…|file://…&gt;</code>.</p>
{{else}}
<p class="asof">Snapshot as of {{.AsOf}}</p>
<div class="tabs">
    <a class="tab{{if not .Eco}} active{{end}}" href="/packages">All</a>
    {{$sel := .Eco}}
    {{range .Ecosystems}}<a class="tab{{if eq . $sel}} active{{end}}" href="/packages?eco={{.}}">{{.}}</a>
    {{end}}
</div>
<div class="band">
    <section class="card band-main">
        <div class="eyebrow">Ever built{{template "def" "Reproduced at least one version."}}</div>
        <div class="hero-figure">{{num .EverBuilt}}</div>
        <div class="hero-sub">of {{num .Total}} packages attempted{{template "def" "Packages with at least one completed attempt."}}, <b>{{num .NeverBuilt}}</b> never built</div>
        <div class="segbar" data-title="{{if .Eco}}{{.Eco}}{{else}}All ecosystems{{end}}">
            {{- if .EverBuilt}}<span class="seg ok" style="flex-grow: {{.EverBuilt}}" data-c="ok" data-v="{{num .EverBuilt}}" data-k="ever built"></span>{{end}}
            {{- if .NeverBuilt}}<span class="seg bad" style="flex-grow: {{.NeverBuilt}}" data-c="bad" data-v="{{num .NeverBuilt}}" data-k="never built"></span>{{end -}}
        </div>
        <div class="legend">
            <span class="legend-item"><i class="swatch ok"></i>Ever built</span>
            <span class="legend-item"><i class="swatch bad"></i>Never built</span>
        </div>
    </section>
    <section class="card">
        <div class="chart-title">Failing streak{{template "def" "Completed builds since the last success on any version, or every build when none succeeded."}}</div>
        <div class="chart-sub"><b>{{num .Failing}}</b> packages whose latest builds failed, by how many in a row</div>
        <div class="chart" data-chart="hist" data-src="streaks" data-h="150" data-unit="failed builds in a row" data-label="packages"></div>
    </section>
</div>
<script type="application/json" id="streaks">{{.Streaks}}</script>
{{if not .Packages}}
<p>No packages recorded in the snapshot.</p>
{{else}}
<p class="showing">Showing {{num .Listed}} of {{num .Total}}, longest failing streak first.</p>
<table>
    <tr>
        {{if not .Eco}}<th>Ecosystem</th>{{end}}
        <th>Package</th>
        <th>Built{{template "def" "Reproduced at least one version."}}</th>
        <th>Versions built{{template "def" "Versions reproduced over versions attempted."}}</th>
        <th>Attempts</th>
        <th>Recent builds{{template "def" "Latest completed builds, oldest first. Successes rise above the line and failures drop below it."}}</th>
        <th>Failing streak{{template "def" "Completed attempts since the last success, on any version."}}</th>
        <th>Last success</th>
        <th>Last attempt</th>
    </tr>
    {{range .Packages}}
    <tr>
        {{if not $.Eco}}<td>{{.Ecosystem}}</td>{{end}}
        <td><a href="/package/{{.EncodedEcosystem}}/{{.EncodedPackage}}">{{.Package}}</a></td>
        <td>{{if .EverBuilt}}<span class="status-success">yes</span>{{else}}<span class="muted">no</span>{{end}}</td>
        <td>{{.VersionsSucceeded}} / {{.VersionsAttempted}}</td>
        <td>{{num .Attempts}}</td>
        <td><span class="beads">{{range .Recent}}<i{{if .}} class="ok"{{end}}></i>{{end}}</span></td>
        <td>{{if .FailingStreak}}<span class="streak">{{.FailingStreak}}</span>{{else}}<span class="muted">0</span>{{end}}</td>
        <td class="wrap">{{if .LastSucceededAt}}{{.LastSucceededAt}} <span class="muted">{{.LastSucceededVersion}}</span>{{else}}<span class="muted">&mdash;</span>{{end}}</td>
        <td class="wrap">{{.LastAttemptedAt}} <span class="muted">{{.LastAttemptedVersion}} {{.LastAttemptedStatus}}</span></td>
    </tr>
    {{end}}
</table>
{{end}}
{{end}}
{{end}}
