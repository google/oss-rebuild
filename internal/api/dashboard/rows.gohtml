{{- define "rebuildRow"}}
<li class="row is-{{.Tone}}">
    <div class="row-head">
        <span class="pip {{.Tone}}" role="img" aria-label="{{.Outcome}}"></span>
        <span class="tag row-kind">rebuild</span>
        <a class="row-name row-pkg" href="/package/{{.Encoded.Ecosystem}}/{{.Encoded.Package}}">{{.Package}}</a>
        <a class="row-ver" href="/package/{{.Encoded.Ecosystem}}/{{.Encoded.Package}}/version/{{.Encoded.Version}}">{{.Version}}</a>
        {{- with variant .Artifact .Version}}<span class="row-var">{{.}}</span>{{end}}
        <span class="tag row-pkg">{{.Ecosystem}}</span>
        <a class="row-end" href="{{.Href}}"><span class="row-outcome tone-{{.Tone}}">{{.Outcome}}</span>{{template "when" .Created}}</a>
    </div>
    {{- if eq .Tone "bad"}}
    <div class="row-sub">
        {{- with stage .Message}}<span class="stage">{{.}}</span>{{end}}
        <a class="cause" href="{{.Href}}" title="{{.Message}}">{{cause .Message}}</a>
    </div>
    {{- end}}
</li>
{{- end}}

{{- define "sessionRow"}}
<li class="row is-{{.Tone}}{{if .StopReason}} is-done{{end}}">
    <div class="row-head">
        <span class="pip {{.Tone}}" aria-hidden="true"></span>
        <span class="tag row-kind">agent</span>
        <a class="row-name row-pkg" href="/package/{{.Encoded.Ecosystem}}/{{.Encoded.Package}}">{{.Target.Package}}</a>
        <a class="row-ver" href="/package/{{.Encoded.Ecosystem}}/{{.Encoded.Package}}/version/{{.Encoded.Version}}">{{.Target.Version}}</a>
        {{- with variant .Target.Artifact .Target.Version}}<span class="row-var">{{.}}</span>{{end}}
        <span class="tag row-pkg">{{.Target.Ecosystem}}</span>
        <a class="row-end" href="/session/{{.ID}}"><span class="tone-{{.Tone}}">{{.Outcome}}</span>{{template "when" .Created}}</a>
    </div>
    {{- with .Reason}}
    <div class="row-sub">
        {{- if eq $.StopReason "GAVE_UP"}}<span class="note" title="{{$.Summary}}">{{.}}</span>
        {{- else}}<a class="cause" href="/session/{{$.ID}}" title="{{$.Summary}}">{{.}}</a>{{end}}
    </div>
    {{- end}}
</li>
{{- end}}

