 SPDX-License-Identifier: Apache-2.0
-->

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OSS Rebuild Dashboard</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
{{template "webfonts"}}    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/dashboard.css">
    <script src="/charts.js" defer></script>
</head>
<body>
<div class="shell">
    <aside class="side">
    <a class="brand" href="/"><img class="mark" src="/favicon.svg" alt="" width="26" height="26">OSS Rebuild</a>
    <nav class="secs" aria-label="Sections">
        {{- range $s := .Frame.Nav}}
        <a href="{{$s.Href}}"><span class="sec-label">{{$s.Label}}</span>
            {{- with $s.Spark}}<svg class="spark{{if $s.Bars}} bars{{end}}" width="56" height="18" viewBox="0 0 56 18" aria-hidden="true"><path d="{{.}}"/></svg>{{end}}
            {{- with $s.Figure}}<span class="sec-fig">{{.}} <span class="sec-unit">{{$s.Unit}}</span></span>{{end}}</a>
        {{- end}}
    </nav>
    {{with .Frame.AsOf}}<p class="side-foot">Snapshot {{.}}</p>{{end}}
    </aside>
    <script>
        // A package's own pages sit under Packages.
        const also = {'/packages': ['/package/', '/attempt/', '/session/']};
        for (const a of document.querySelectorAll('.secs a')) {
            const p = a.getAttribute('href'), at = location.pathname;
            if (at === p || (p !== '/' && at.startsWith(p + '/')) || (also[p] || []).some(q => at.startsWith(q))) a.setAttribute('aria-current', 'page');
        }
        // Pages render server-side and can take seconds, so a same-origin
        // link click shows a progress bar until the next page replaces this
        // one. pageshow clears it when the back-forward cache restores a page.
        addEventListener('click', e => {
            const a = e.target.closest('a[href]');
            if (!a || e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || a.target || a.origin !== location.origin) return;
            if (a.hash && a.pathname === location.pathname && a.search === location.search) return;
            document.documentElement.classList.add('navigating');
        });
        addEventListener('pageshow', () => document.documentElement.classList.remove('navigating'));
    </script>
    <main class="page">
{{block "content" .}}{{end}}
    </main>
</div>
</body>
</html>
{{- define "when"}}<time datetime="{{.UTC.Format "2006-01-02T15:04:05Z"}}" title="{{.Format "2006-01-02 15:04:05 MST"}}">{{ago .}}</time>{{end}}
