 SPDX-License-Identifier: Apache-2.0
-->

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OSS Rebuild Dashboard</title>
    <link rel="icon" href="{{asset "/favicon.svg"}}" type="image/svg+xml">
{{template "webfonts"}}    <link rel="stylesheet" href="{{asset "/theme.css"}}">
    <link rel="stylesheet" href="{{asset "/dashboard.css"}}">
    <script src="{{asset "/dashboard.js"}}" defer></script>
    <script src="{{asset "/charts.js"}}" defer></script>
</head>
<body>
<div class="shell">
    <aside class="side">
    <a class="brand" href="/"><img class="mark" src="{{asset "/favicon.svg"}}" alt="" width="26" height="26">OSS Rebuild</a>
    <nav class="secs" aria-label="Sections">
        {{- range $s := .Frame.Nav}}
        <a href="{{$s.Href}}"><span class="sec-label">{{$s.Label}}</span>
            {{- with $s.Spark}}<svg class="spark{{if $s.Bars}} bars{{end}}" width="56" height="18" viewBox="0 0 56 18" aria-hidden="true"><path d="{{.}}"/></svg>{{end}}
            {{- with $s.Figure}}<span class="sec-fig">{{.}} <span class="sec-unit">{{$s.Unit}}</span></span>{{end}}</a>
        {{- end}}
    </nav>
    {{with .Frame.AsOf}}<p class="side-foot">Snapshot {{.}}</p>{{end}}
    </aside>
    <main class="page">
{{block "content" .}}{{end}}
    </main>
</div>
</body>
</html>
{{- define "when"}}<time datetime="{{.UTC.Format "2006-01-02T15:04:05Z"}}" title="{{.Format "2006-01-02 15:04:05 MST"}}">{{ago .}}</time>{{end}}
