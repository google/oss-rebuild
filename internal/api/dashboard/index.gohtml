{{define "content"}}
<!--
 Copyright 2026 Google LLC
 SPDX-License-Identifier: Apache-2.0
-->

    {{with .Overview}}
    <section class="card hero">
        <div class="hero-main">
            <div class="eyebrow">Packages reproduced</div>
            <div class="hero-figure">{{num .Reproduced}}</div>
            <div class="hero-sub"><b>{{.Total.Pct}}%</b> of {{num .InScope}} in scope across {{len .Ecos}} ecosystems, {{num .Started}} started</div>
            {{template "standing" .Total}}
            {{template "standing-legend"}}
        </div>
        <div class="hero-side">
            <div class="chart-title">Builds per day</div>
            <div class="chart" data-chart="columns" data-src="overview-activity" data-h="150" data-label="Completed builds per day, succeeded and failed"></div>
            <div class="legend">
                <span class="legend-item"><i class="swatch ok"></i>Succeeded</span>
                <span class="legend-item"><i class="swatch bad"></i>Failed</span>
            </div>
        </div>
    </section>
    {{template "ecocards" .Ecos}}
    <p class="asof">Snapshot as of {{.AsOf}}</p>
    <script type="application/json" id="overview">{{.}}</script>
    <script type="application/json" id="overview-activity">{{.Activity}}</script>
    {{end}}

    {{if .BenchmarkTargets}}
        <h2>{{if .BenchmarkTitle}}{{.BenchmarkTitle}}{{else}}Tracked Packages{{end}}</h2>
        <p>Total: {{.BenchmarkStats.Total}} | Success: {{.BenchmarkStats.Success}} | Failed: {{.BenchmarkStats.Failed}}</p>
        <div class="benchmark-grid">
            {{range .BenchmarkTargets}}
                <a href="/package/{{.EncodedEcosystem}}/{{.EncodedPackage}}" class="benchmark-item {{if not .HasRun}}bg-gray{{else if .Success}}bg-green{{else}}bg-red{{end}}" title="{{.Ecosystem}}: {{.Package}}">
                    {{.Package}}
                </a>
            {{end}}
        </div>
    {{end}}

    {{if .RecentRebuilds}}
        <h2>Recent Rebuilds</h2>
        <table>
            <thead>
                <tr>
                    <th>Ecosystem</th>
                    <th>Package</th>
                    <th>Version</th>
                    <th>Artifact</th>
                    <th>Status</th>
                    <th>RunID</th>
                    <th>Attempt</th>
                    <th>Completed</th>
                </tr>
            </thead>
            <tbody>
                {{range .RecentRebuilds}}
                <tr>
                    <td>{{.Ecosystem}}</td>
                    <td><a href="/package/{{.Encoded.Ecosystem}}/{{.Encoded.Package}}">{{.Package}}</a></td>
                    <td>{{.Version}}</td>
                    <td class="wrap">{{.Artifact}}</td>
                    <td>
                        {{if .Success}}
                            <span class="status-success">Success</span>
                        {{else}}
                            <span class="status-fail">Failed</span>
                        {{end}}
                    </td>
                    <td>{{.RunID}}</td>
                    <td><a href="/attempt/{{.Encoded.Ecosystem}}/{{.Encoded.Package}}/{{.Encoded.Version}}/{{.Encoded.Artifact}}/{{.RunID}}">view</a></td>
                    <td>{{template "when" .Created}}</td>
                </tr>
                {{end}}
            </tbody>
        </table>
    {{end}}

    {{if .RecentSessions}}
        <h2>Recent Agent Sessions</h2>
        <table>
            <thead>
                <tr>
                    <th>Ecosystem</th>
                    <th>Package</th>
                    <th>Version</th>
                    <th>Status</th>
                    <th>Summary</th>
                    <th>Session</th>
                    <th>Completed</th>
                </tr>
            </thead>
            <tbody>
                {{range .RecentSessions}}
                <tr>
                    <td>{{.Target.Ecosystem}}</td>
                    <td><a href="/package/{{.Encoded.Ecosystem}}/{{.Encoded.Package}}">{{.Target.Package}}</a></td>
                    <td>{{.Target.Version}}</td>
                    <td>
                        {{if eq .StopReason "SUCCESS"}}
                            <span class="status-success">Success</span>
                        {{else if .StopReason}}
                            <span class="status-fail">{{.StopReason}}</span>
                        {{else}}
                            {{.Status}}
                        {{end}}
                    </td>
                    <td><small>{{.Summary}}</small></td>
                    <td><small><a href="/session/{{.ID}}">{{.ID}}</a></small></td>
                    <td>{{template "when" .Created}}</td>
                </tr>
                {{end}}
            </tbody>
        </table>
    {{end}}
{{end}}
