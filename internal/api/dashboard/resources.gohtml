{{define "content"}}
<!--
 Copyright 2026 Google LLC
 SPDX-License-Identifier: Apache-2.0
-->

<style>
    .barcell { width: 30%; min-width: 150px; }
</style>

<h2>Resources</h2>
{{if not .Loaded}}
<p>No analytics snapshot loaded. Start the dashboard with
<code>-rundex=&lt;gs://…|file://…&gt;</code>.</p>
{{else}}
<p class="asof">Snapshot as of {{.AsOf}} &middot; last {{.WindowDays}} days</p>

<div class="tiles">
    <section class="card tile"><div class="eyebrow">Attempts</div><div class="tile-value">{{num .TotalAttempts}}</div><div class="chart" data-chart="spark" data-src="window" data-field="Attempts" data-label="attempts"></div></section>
    <section class="card tile"><div class="eyebrow">Successes</div><div class="tile-value">{{num .TotalSuccesses}}</div><div class="chart" data-chart="spark" data-src="window" data-field="Succeeded" data-label="successes"></div></section>
    <section class="card tile"><div class="eyebrow">LLM tokens</div><div class="tile-value">{{.TotalTokens}}</div><div class="chart" data-chart="spark" data-src="window" data-field="Tokens" data-fmt="compact" data-label="tokens"></div></section>
    <section class="card tile"><div class="eyebrow">Builder hours</div><div class="tile-value">{{printf "%.1f" .TotalBuilderHours}}</div><div class="chart" data-chart="spark" data-src="window" data-field="BuilderHours" data-fmt="hours" data-label="builder time"></div></section>
    <section class="card tile"><div class="eyebrow">Scratch VM hours</div><div class="tile-value">{{printf "%.1f" .TotalVMHours}}</div><div class="chart" data-chart="spark" data-src="window" data-field="VMHours" data-fmt="hours" data-label="scratch VM time"></div></section>
</div>
<script type="application/json" id="window">{{.Window}}</script>

<h3>Daily activity</h3>
<div class="tabs">
    <a class="tab{{if not .Eco}} active{{end}}" href="/resources">All</a>
    {{$sel := .Eco}}
    {{range .Ecosystems}}<a class="tab{{if eq . $sel}} active{{end}}" href="/resources?eco={{.}}">{{.}}</a>
    {{end}}
</div>
{{if not .Days}}
<p>No attempts recorded in the window.</p>
{{else}}
<section class="card chart-card">
    <div class="chart" data-chart="columns" data-src="activity" data-h="180" data-label="Completed builds per day, succeeded and failed"></div>
    <div class="legend">
        <span class="legend-item"><i class="swatch ok"></i>Succeeded</span>
        <span class="legend-item"><i class="swatch bad"></i>Failed</span>
    </div>
</section>
<script type="application/json" id="activity">{{.Activity}}</script>
<table>
    <tr>
        <th>Day</th>
        <th>Attempts</th>
        <th>Successes</th>
        <th>Success %</th>
        <th>Builder min</th>
        <th>Tokens</th>
        <th>VM min</th>
    </tr>
    {{range .Days}}
    <tr>
        <td>{{.Day}}</td>
        <td>{{num .Attempts}}</td>
        <td>{{num .Successes}}</td>
        <td>{{.SuccessPct}}%</td>
        <td>{{printf "%.1f" .BuilderMinutes}}</td>
        <td>{{.Tokens}}</td>
        <td>{{printf "%.1f" .VMMinutes}}</td>
    </tr>
    {{end}}
</table>
{{end}}

<h3>Most expensive packages</h3>
{{if not .TopPackages}}
<p>No builder-time measurements in the window.</p>
{{else}}
<table>
    <tr>
        <th>Ecosystem</th>
        <th>Package</th>
        <th>Attempts</th>
        <th>Builder min</th>
        <th class="barcell"></th>
    </tr>
    {{range .TopPackages}}
    <tr>
        <td>{{.Ecosystem}}</td>
        <td>{{.Package}}</td>
        <td>{{num .Attempts}}</td>
        <td>{{printf "%.1f" .BuilderMinutes}}</td>
        <td class="barcell"><div class="bar" style="width: {{.BarPct}}%"></div></td>
    </tr>
    {{end}}
</table>
{{end}}
{{end}}
{{end}}
