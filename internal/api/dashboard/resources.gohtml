 SPDX-License-Identifier: Apache-2.0
-->

<style>
    .barcell { width: 30%; min-width: 150px; }
</style>

<h2>Resources</h2>
{{if not .Loaded}}
<p>No analytics snapshot loaded. Start the dashboard with
<code>-rundex=&lt;gs://…|file://…&gt;</code>.</p>
{{else}}
<p class="asof">Snapshot as of {{.AsOf}} &middot; last {{.WindowDays}} days</p>

<div class="cards">
    <div class="card"><div class="card-value">{{.TotalAttempts}}</div><div class="card-label">attempts</div></div>
    <div class="card"><div class="card-value">{{.TotalSuccesses}}</div><div class="card-label">successes</div></div>
    <div class="card"><div class="card-value">{{.TotalTokens}}</div><div class="card-label">LLM tokens</div></div>
    <div class="card"><div class="card-value">{{printf "%.1f" .TotalBuilderHours}}</div><div class="card-label">builder hours</div></div>
    <div class="card"><div class="card-value">{{printf "%.1f" .TotalVMHours}}</div><div class="card-label">scratch VM hours</div></div>
</div>

<h3>Daily activity</h3>
<div class="tabs">
    <a class="tab{{if not .Eco}} active{{end}}" href="/resources">All</a>
    {{$sel := .Eco}}
    {{range .Ecosystems}}<a class="tab{{if eq . $sel}} active{{end}}" href="/resources?eco={{.}}">{{.}}</a>
    {{end}}
</div>
{{if not .Days}}
<p>No attempts recorded in the window.</p>
{{else}}
<table>
    <tr>
        <th>Day</th>
        <th>Attempts</th>
        <th class="barcell"></th>
        <th>Successes</th>
        <th>Success %</th>
        <th>Builder min</th>
        <th>Tokens</th>
        <th>VM min</th>
    </tr>
    {{range .Days}}
    <tr>
        <td>{{.Day}}</td>
        <td>{{.Attempts}}</td>
        <td class="barcell"><div class="bar" style="width: {{.AttemptsBarPct}}%"></div></td>
        <td>{{.Successes}}</td>
        <td>{{.SuccessPct}}%</td>
        <td>{{printf "%.1f" .BuilderMinutes}}</td>
        <td>{{.Tokens}}</td>
        <td>{{printf "%.1f" .VMMinutes}}</td>
    </tr>
    {{end}}
</table>
{{end}}

<h3>Most expensive packages</h3>
{{if not .TopPackages}}
<p>No builder-time measurements in the window.</p>
{{else}}
<table>
    <tr>
        <th>Ecosystem</th>
        <th>Package</th>
        <th>Attempts</th>
        <th>Builder min</th>
        <th class="barcell"></th>
    </tr>
    {{range .TopPackages}}
    <tr>
        <td>{{.Ecosystem}}</td>
        <td>{{.Package}}</td>
        <td>{{.Attempts}}</td>
        <td>{{printf "%.1f" .BuilderMinutes}}</td>
        <td class="barcell"><div class="bar" style="width: {{.BarPct}}%"></div></td>
    </tr>
    {{end}}
</table>
{{end}}
{{end}}
{{end}}
