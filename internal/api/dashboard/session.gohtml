    <h2>Agent Session</h2>
    <div class="session">
        <div class="session-head">
            <a href="/package/{{.Session.Encoded.Ecosystem}}/{{.Session.Encoded.Package}}/version/{{.Session.Encoded.Version}}"><strong>{{.Session.Target.Ecosystem}}:{{.Session.Target.Package}} {{.Session.Target.Version}}</strong></a>
            {{if eq .Session.StopReason "SUCCESS"}}<span class="status-success">Success</span>
            {{else if .Session.StopReason}}<span class="status-fail">{{.Session.StopReason}}</span>
            {{else if eq .Session.Status "RUNNING"}}<span class="status-running">Running</span>
            {{else}}<span>{{.Session.Status}}</span>{{end}}
            <span class="badge">{{if .Session.ExecutionMode}}{{.Session.ExecutionMode}}{{else}}gcb{{end}}</span>
            <span class="session-meta">{{if .Session.ExecutionName}}hosted{{else}}local{{end}} · {{.Session.Created.Format "2006-01-02 15:04:05"}}</span>
        </div>
        {{if .Session.Summary}}<div class="session-summary">{{.Session.Summary}}</div>{{end}}
        <div class="kv">
            <div><span class="kv-label">session</span><span class="kv-value mono" title="{{.Session.ID}}">{{.Session.ID}}</span></div>
            {{if .Session.ScratchID}}<div><span class="kv-label">scratch</span><span class="kv-value mono" title="{{.Session.ScratchID}}">{{.Session.ScratchID}}</span></div>{{end}}
            {{if .Session.Model}}<div><span class="kv-label">model</span><span class="kv-value">{{.Session.Model}}</span></div>{{end}}
            <div><span class="kv-label">duration</span><span class="kv-value">{{if .Duration}}{{.Duration}}{{else}}n/a{{end}}</span></div>
            {{if .Usage}}<div><span class="kv-label">tokens</span><span class="kv-value">{{.Usage}}</span></div>{{end}}
            {{if .Session.MaxIterations}}<div><span class="kv-label">max iterations</span><span class="kv-value">{{.Session.MaxIterations}}</span></div>{{end}}
            {{if .Session.RunID}}<div><span class="kv-label">run</span><span class="kv-value mono" title="{{.Session.RunID}}">{{.Session.RunID}}</span></div>{{end}}
        </div>
    </div>

    {{range .Warnings}}<p class="hint">Warning: {{.}}</p>{{end}}

    <h3>Trajectory</h3>
    {{if .Trajectory}}
    {{range .Trajectory}}
    <div class="traj-iter">
        <div class="traj-iter-head">
            <strong>Iteration {{.Number}}</strong>
            {{with .Record}}
            <span class="session-meta">
                {{.Status}}
                {{if .Result}} · {{if .Result.BuildSuccess}}build ok{{else}}{{.Result.ErrorMessage}}{{end}}{{end}}
                {{if .ObliviousID}} · build {{.ObliviousID}}{{end}}
            </span>
            {{end}}
            {{if .RecordUsage}}<span class="session-meta"> · {{.RecordUsage}}</span>{{end}}
        </div>
        {{if .RecordStrategy}}
        <details class="traj-body"><summary>show recorded strategy</summary><pre>{{.RecordStrategy}}</pre></details>
        {{end}}
    </div>
    {{end}}
    {{else}}
    <p class="hint">No trajectory recorded.</p>
    {{end}}
</body>
</html>
