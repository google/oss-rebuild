{{- define "def"}}<span class="info" tabindex="0" data-tip="{{.}}">?</span>{{end}}
{{- define "ecocards"}}
<div class="eco-cards">
    {{range .}}
    <section class="card eco-card">
        <div class="eco-head"><h3>{{.Ecosystem}}</h3><a href="/coverage?eco={{.Ecosystem}}">Coverage</a></div>
        <div class="figure"><span class="figure-value">{{num .Reproduced}}</span><span class="figure-pct">{{.Pct}}%</span></div>
        <div class="figure-label">reproduced of {{num .Attempted}} attempted, {{num .InScope}} in scope</div>
        {{template "standing" .}}
        <div class="chart" data-chart="growth" data-src="overview" data-eco="{{.Ecosystem}}" data-label="{{.Ecosystem}} packages reproduced at any version over time"></div>
        <div class="chart-note">Reproduced at any version, cumulative: {{num .EverBuilt}}</div>
    </section>
    {{end}}
</div>
{{- end}}
{{- define "standing"}}
<div class="segbar" data-title="{{.Title}}">
    {{- if .Reproduced}}<span class="seg ok" style="flex-grow: {{.Reproduced}}" data-c="ok" data-v="{{num .Reproduced}}" data-k="reproduced"></span>{{end}}
    {{- with .NotReproduced}}<span class="seg warn" style="flex-grow: {{.}}" data-c="warn" data-v="{{num .}}" data-k="not reproduced"></span>{{end}}
    {{- if .Retrying}}<span class="seg retry" style="flex-grow: {{.Retrying}}" data-c="retry" data-v="{{num .Retrying}}" data-k="not reproduced, retrying"></span>{{end}}
    {{- if .InFlight}}<span class="seg live" style="flex-grow: {{.InFlight}}" data-c="live" data-v="{{num .InFlight}}" data-k="in flight"></span>{{end}}
    {{- if .Queued}}<span class="seg none" style="flex-grow: {{.Queued}}" data-c="none" data-v="{{num .Queued}}" data-k="queued"></span>{{end -}}
</div>
{{- end}}
{{- define "standing-legend"}}
<div class="legend">
    <span class="legend-item"><i class="swatch ok"></i>Reproduced</span>
    <span class="legend-item"><i class="swatch warn"></i>Not reproduced</span>
    <span class="legend-item"><i class="swatch retry"></i>Retrying</span>
    <span class="legend-item"><i class="swatch live"></i>In flight</span>
    <span class="legend-item"><i class="swatch none"></i>Queued</span>
</div>
{{- end}}
{{- define "campaigns"}}
<div class="segbar" data-title="{{.Ecosystem}} campaigns">
    {{- range .DoneByStage}}{{if .Done}}<span class="seg stage-{{.Stage}}" style="flex-grow: {{.Done}}" data-c="stage-{{.Stage}}" data-v="{{num .Done}}" data-k="attested at {{.Stage}}"></span>{{end}}{{end}}
    {{- if .NeedsTriage}}<span class="seg warn" style="flex-grow: {{.NeedsTriage}}" data-c="warn" data-v="{{num .NeedsTriage}}" data-k="needs triage"></span>{{end}}
    {{- if .InFlight}}<span class="seg live" style="flex-grow: {{.InFlight}}" data-c="live" data-v="{{num .InFlight}}" data-k="in flight"></span>{{end}}
    {{- if .Queued}}<span class="seg none" style="flex-grow: {{.Queued}}" data-c="none" data-v="{{num .Queued}}" data-k="queued"></span>{{end -}}
</div>
{{- end}}
{{- define "progress"}}
<div class="segbar" data-title="{{.Ecosystem}} campaigns">
    {{- with .Inferred}}<span class="seg stage-infer" style="flex-grow: {{.}}" data-c="stage-infer" data-v="{{num .}}" data-k="attested by inference"></span>{{end}}
    {{- with .Diagnosed}}<span class="seg stage-agent" style="flex-grow: {{.}}" data-c="stage-agent" data-v="{{num .}}" data-k="attested by the agent"></span>{{end}}
    {{- if .NeedsTriage}}<span class="seg warn" style="flex-grow: {{.NeedsTriage}}" data-c="warn" data-v="{{num .NeedsTriage}}" data-k="needs triage"></span>{{end}}
    {{- if .InFlight}}<span class="seg live" style="flex-grow: {{.InFlight}}" data-c="live" data-v="{{num .InFlight}}" data-k="in flight"></span>{{end}}
    {{- if .Queued}}<span class="seg none" style="flex-grow: {{.Queued}}" data-c="none" data-v="{{num .Queued}}" data-k="queued"></span>{{end -}}
</div>
{{- end}}
{{- define "progress-legend"}}
<div class="legend">
    <span class="legend-item"><i class="swatch stage-infer"></i>Attested by inference{{template "def" "Inference, a replay, or a sibling version's strategy reproduced it, including as an agent session's first build."}}</span>
    <span class="legend-item"><i class="swatch stage-agent"></i>Attested by the agent{{template "def" "A build the agent proposed or handed off reproduced it."}}</span>
    <span class="legend-item"><i class="swatch warn"></i>Needs triage</span>
    <span class="legend-item"><i class="swatch live"></i>In flight</span>
    <span class="legend-item"><i class="swatch none"></i>Queued</span>
</div>
{{- end}}
{{- define "campaigns-legend"}}
<div class="legend">
    <span class="legend-item"><i class="swatch stage-replay"></i>Attested at replay</span>
    <span class="legend-item"><i class="swatch stage-infer"></i>Attested at infer</span>
    <span class="legend-item"><i class="swatch stage-agent"></i>Attested at agent</span>
    <span class="legend-item"><i class="swatch warn"></i>Needs triage</span>
    <span class="legend-item"><i class="swatch live"></i>In flight</span>
    <span class="legend-item"><i class="swatch none"></i>Queued</span>
</div>
{{- end}}
