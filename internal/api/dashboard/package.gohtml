    <h2>{{.Ecosystem}}: {{.PackageName}}</h2>

    <div class="cards">
        <div class="card">
            <div class="card-value">{{.Summary.VerifiedPct}}%</div>
            <div class="card-label">verified of {{.Summary.Attempted}} attempted</div>
        </div>
        <div class="card">
            <div class="card-value">{{.Summary.Verified}}</div>
            <div class="card-label">verified</div>
        </div>
        <div class="card">
            <div class="card-value">{{.Summary.Failed}}</div>
            <div class="card-label">failed</div>
        </div>
        <div class="card">
            <div class="card-value">{{.Summary.Running}}</div>
            <div class="card-label">running</div>
        </div>
        <div class="card">
            <div class="card-value">{{.Summary.AgentRuns}}</div>
            <div class="card-label">agent runs</div>
        </div>
    </div>

    {{if .Versions}}
    <div class="strip-head">
        <span>Versions (most recently active first) &middot; {{.WindowFrom}}-{{.WindowTo}} of {{.Summary.Attempted}}</span>
        <span class="strip-nav">
            {{/* TODO: Move these client-side */}}
            {{if .Expanded}}<a href="?offset={{.Offset}}">Collapse</a>{{else}}<a href="?offset={{.Offset}}&expanded=1">Expand</a>{{end}}
            {{if .HasPrev}}<a href="?offset={{.PrevOffset}}{{if .Expanded}}&expanded=1{{end}}">newer</a>{{end}}
            {{if .HasNext}}<a href="?offset={{.NextOffset}}{{if .Expanded}}&expanded=1{{end}}">older</a>{{end}}
        </span>
    </div>
    <div class="strip{{if .Expanded}} expanded{{end}}">
        {{range .Versions}}
        <a class="cell state-{{.State}}"
           href="/package/{{.Encoded.Ecosystem}}/{{.Encoded.Package}}/version/{{.Encoded.Version}}"
           title="{{.Version}} &middot; {{.State}}{{if .Agent}} &middot; agent {{.Agent}}{{end}}"></a>
        {{end}}
    </div>
    <div class="legend">
        <span class="legend-item"><span class="legend-swatch state-verified"></span>verified</span>
        <span class="legend-item"><span class="legend-swatch state-failed"></span>failed</span>
        <span class="legend-item"><span class="legend-swatch state-running"></span>running</span>
    </div>
    {{end}}
    <table>
        <thead>
            <tr>
                <th>Type</th>
                <th>Version</th>
                <th>Artifact</th>
                <th>Status</th>
                <th>Message</th>
                <th>Reference</th>
                <th>Completed</th>
            </tr>
        </thead>
        <tbody>
            {{range .Events}}
            {{if .Session}}
            {{with .Session}}
            <tr>
                <td>Agent</td>
                <td>{{.Target.Version}}</td>
                <td>{{.Target.Artifact}}</td>
                <td>
                    {{if eq .StopReason "SUCCESS"}}
                        <span class="status-success">Success</span>
                    {{else if .StopReason}}
                        <span class="status-fail">{{.StopReason}}</span>
                    {{else}}
                        {{.Status}}
                    {{end}}
                </td>
                <td><small>{{.Summary}}</small></td>
                <td><small>{{.ID}}</small></td>
                <td>{{.Created.Format "2006-01-02 15:04:05"}}</td>
            </tr>
            {{end}}
            {{else}}
            {{with .Rebuild}}
            <tr>
                <td>Rebuild</td>
                <td>{{.Version}}</td>
                <td>{{.Artifact}}</td>
                <td>
                    {{if .Success}}
                        <span class="status-success">Success</span>
                    {{else}}
                        <span class="status-fail">Failed</span>
                    {{end}}
                </td>
                <td><small>{{.Message}}</small></td>
                <td><a href="/attempt/{{.Encoded.Ecosystem}}/{{.Encoded.Package}}/{{.Encoded.Version}}/{{.Encoded.Artifact}}/{{.RunID}}">{{.RunID}}</a></td>
                <td>{{.Created.Format "2006-01-02 15:04:05"}}</td>
            </tr>
            {{end}}
            {{end}}
            {{end}}
        </tbody>
    </table>
</body>
</html>
