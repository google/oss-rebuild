{{define "def"}}<span class="info" tabindex="0" data-tip="{{.}}">?</span>{{end}}
{{define "content"}}
<!--
 Copyright 2026 Google LLC
 SPDX-License-Identifier: Apache-2.0
-->

<style>
    th.group { text-align: center; color: var(--muted); font-weight: 400; }
    .barcell { width: 25%; min-width: 120px; }
</style>

<h2>Coverage</h2>
{{if not .Loaded}}
<p>No analytics snapshot loaded. Start the dashboard with
<code>-rundex=&lt;gs://…|file://…&gt;</code>.</p>
{{else}}
<p class="asof">{{with .Overview}}Package counts from the rollup at {{.AsOf}}. {{end}}Campaign counts as of {{.AsOf}}.</p>
<div class="tabs">
    <a class="tab{{if not .Eco}} active{{end}}" href="/coverage">All</a>
    {{$sel := .Eco}}
    {{range .Ecos}}<a class="tab{{if eq .Ecosystem $sel}} active{{end}}" href="/coverage?eco={{.Ecosystem}}">{{.Ecosystem}}</a>
    {{end}}
</div>
{{with .Overview}}
{{template "ecocards" (.Only $.Eco)}}
{{template "standing-legend"}}
<script type="application/json" id="overview">{{.}}</script>
{{end}}
{{$campaigns := false}}{{range .Ecos}}{{if and .HasQueue (or (not $.Eco) (eq .Ecosystem $.Eco))}}{{$campaigns = true}}{{end}}{{end}}
{{if $campaigns}}
<section class="card outcomes">
    <div class="chart-title">Campaign outcomes{{template "def" "One campaign per package version. Attested campaigns are split by the stage that attested them."}}</div>
    {{range .Ecos}}{{if and .HasQueue (or (not $.Eco) (eq .Ecosystem $.Eco))}}
    <div class="outcome-row">
        <div class="outcome-name">{{.Ecosystem}}</div>
        <div class="segbar" data-title="{{.Ecosystem}} campaigns">
            {{- range .DoneByStage}}{{if .Done}}<span class="seg stage-{{.Stage}}" style="flex-grow: {{.Done}}" data-c="stage-{{.Stage}}" data-v="{{num .Done}}" data-k="attested at {{.Stage}}"></span>{{end}}{{end}}
            {{- if .NeedsTriage}}<span class="seg warn" style="flex-grow: {{.NeedsTriage}}" data-c="warn" data-v="{{num .NeedsTriage}}" data-k="needs triage"></span>{{end}}
            {{- if .InFlight}}<span class="seg live" style="flex-grow: {{.InFlight}}" data-c="live" data-v="{{num .InFlight}}" data-k="in flight"></span>{{end}}
            {{- if .Queued}}<span class="seg none" style="flex-grow: {{.Queued}}" data-c="none" data-v="{{num .Queued}}" data-k="queued"></span>{{end -}}
        </div>
        <div class="outcome-total">{{num .Campaigns}}</div>
    </div>
    {{end}}{{end}}
    <div class="legend">
        <span class="legend-item"><i class="swatch stage-replay"></i>Attested at replay</span>
        <span class="legend-item"><i class="swatch stage-infer"></i>Attested at infer</span>
        <span class="legend-item"><i class="swatch stage-agent"></i>Attested at agent</span>
        <span class="legend-item"><i class="swatch warn"></i>Needs triage</span>
        <span class="legend-item"><i class="swatch live"></i>In flight</span>
        <span class="legend-item"><i class="swatch none"></i>Queued</span>
    </div>
</section>
{{end}}
{{with .Tiers}}
<section class="card chart-card">
    <div class="chart-title">Popularity tiers{{template "def" "Reproduced over attempted among each ecosystem's top tracked packages by score. A tier larger than the ecosystem holds all of its packages."}}</div>
    <div class="tier-tiles">
        {{range .}}
        <div class="tier-tile">
            <h3>{{.Ecosystem}}</h3>
            {{range .Tiers}}
            <div class="tier-row{{if lt .Pct 80}} weak{{end}}">
                <span class="tier-label">{{.Label}}</span>
                {{template "standing" .}}
                <b>{{.Pct}}%</b>
            </div>
            {{end}}
        </div>
        {{end}}
    </div>
    {{template "standing-legend"}}
</section>
{{end}}
{{with .Releases}}{{if .Ecos}}
<section class="card chart-card">
    <div class="chart-head">
        <div class="chart-title">Release cohorts{{template "def" "Reproduced over attempted for the tracked packages' enqueued versions, by the year each was published."}}</div>
        <div class="chart-switch" data-switch="release-chart" role="group" aria-label="Release cohort form">
            <button type="button" data-form="releaselines" aria-pressed="true">With volume</button>
            <button type="button" data-form="releaseshare" aria-pressed="false">Volume share</button>
        </div>
    </div>
    <div class="chart" id="release-chart" data-chart="releaselines" data-src="releases" data-label="Reproduced rate by release year, by ecosystem"></div>
    <div class="chart-note">With volume: the line is the rate on a 50&ndash;100% scale over each year's version count. Volume share: each column stacks a year's attempted versions to 100%, so its reproduced part is the rate. Counts are square-root scaled on one scale across ecosystems, and faded marks have fewer than 30 attempted.</div>
    <script type="application/json" id="releases">{{.}}</script>
</section>
{{end}}{{end}}
{{with .Spend}}{{if .Ecos}}
<section class="card chart-card">
    <div class="chart-title">Resources{{template "def" "Core-hours convert each resource to n2 vCPU-hours at list price: a build-worker hour is about 15, an inference request-hour about 7.7 (an upper bound, since instances serve concurrent requests), an agent guest hour 4, and a million LLM tokens about 15 fresh input, 1.5 cached input or 77 output."}}</div>
    <div class="chart-sub">Core-hours by ecosystem, {{.From}} to {{.To}}</div>
    <table class="spend">
        <tr>
            <th></th>
            <th>Share{{template "def" "Of every ecosystem's core-hours."}}</th>
            <th>What it went to</th>
            <th>Per new version{{template "def" "Core-hours per version reproduced for the first time."}}</th>
        </tr>
        {{range .Ecos}}
        <tr>
            <td>{{.Ecosystem}}</td>
            <td>{{.Share}}%</td>
            <td class="barcell">
                <div class="segbar" data-title="{{.Ecosystem}}, {{printf "%.0f" .Total}} core-hours">
                    {{- if .Builder}}<span class="seg cost-builder" style="flex-grow: {{printf "%.2f" .Builder}}" data-c="cost-builder" data-v="{{printf "%.0f" .Builder}} core-h" data-k="build workers"></span>{{end}}
                    {{- if .Inference}}<span class="seg cost-infer" style="flex-grow: {{printf "%.2f" .Inference}}" data-c="cost-infer" data-v="{{printf "%.0f" .Inference}} core-h" data-k="inference"></span>{{end}}
                    {{- if .Guests}}<span class="seg cost-guest" style="flex-grow: {{printf "%.2f" .Guests}}" data-c="cost-guest" data-v="{{printf "%.0f" .Guests}} core-h" data-k="agent guests"></span>{{end}}
                    {{- if .LLM}}<span class="seg cost-llm" style="flex-grow: {{printf "%.2f" .LLM}}" data-c="cost-llm" data-v="{{printf "%.0f" .LLM}} core-h" data-k="LLM tokens"></span>{{end -}}
                </div>
            </td>
            <td>{{with .PerVersion}}{{.}} core-h{{else}}&mdash;{{end}}</td>
        </tr>
        {{end}}
    </table>
    <div class="legend">
        <span class="legend-item"><i class="swatch cost-builder"></i>Build workers</span>
        <span class="legend-item"><i class="swatch cost-infer"></i>Inference</span>
        <span class="legend-item"><i class="swatch cost-guest"></i>Agent guests</span>
        <span class="legend-item"><i class="swatch cost-llm"></i>LLM tokens</span>
    </div>
</section>
{{end}}{{end}}
{{if not .Detail}}
{{if not .Ecos}}
<p>No attempts, signals, or campaigns in the snapshot.</p>
{{else}}
<table>
    <tr>
        <th></th>
        <th class="group" colspan="5">Packages</th>
        <th class="group" colspan="4">Campaigns{{template "def" "One campaign per package version."}}</th>
    </tr>
    <tr>
        <th>Ecosystem</th>
        <th>In scope{{template "def" "Ranked packages with a campaign or an attempt."}}</th>
        <th>Attempted{{template "def" "In scope, with a completed build at any version."}}</th>
        <th>Reproduced{{template "def" "Attested at the latest version attempted."}}</th>
        <th>Success{{template "def" "Reproduced over attempted. A failure being retried counts against it until a retry succeeds."}}</th>
        <th>Weighted{{template "def" "Success, weighting each package by its score."}}</th>
        <th>Queued{{template "def" "Campaigns waiting for dispatch at their next stage."}}</th>
        <th>In flight{{template "def" "Campaigns dispatched and awaiting an outcome."}}</th>
        <th>Needs triage{{template "def" "Campaigns whose automated stages are exhausted, awaiting a person."}}</th>
        <th>Done{{template "def" "Campaigns attested."}}</th>
    </tr>
    {{range .Ecos}}
    <tr>
        <td><a href="/coverage?eco={{.Ecosystem}}">{{.Ecosystem}}</a></td>
        {{if .HasScope}}
        <td>{{num .InScope}}</td>
        <td>{{num .Attempted}}</td>
        <td>{{num .Reproduced}}</td>
        <td>{{.SuccessPct}}%</td>
        <td>{{.WeightedPct}}%</td>
        {{else}}
        <td>&mdash;</td><td>&mdash;</td><td>&mdash;</td><td>&mdash;</td><td>&mdash;</td>
        {{end}}
        {{if .HasQueue}}
        <td>{{num .Queued}}</td>
        <td>{{num .InFlight}}</td>
        <td>{{num .NeedsTriage}}</td>
        <td>{{num .Done}}</td>
        {{else}}
        <td>&mdash;</td><td>&mdash;</td><td>&mdash;</td><td>&mdash;</td>
        {{end}}
    </tr>
    {{end}}
</table>
{{end}}
{{else}}
{{with .Detail}}
<h3>Packages</h3>
{{if .HasScope}}
<div class="cards">
    <div class="card"><div class="card-value">{{num .InScope}}</div><div class="card-label">in scope{{template "def" "Ranked packages with a campaign or an attempt."}}</div></div>
    <div class="card"><div class="card-value">{{num .Attempted}}</div><div class="card-label">attempted{{template "def" "In scope, with a completed build at any version."}}</div></div>
    <div class="card"><div class="card-value">{{num .Reproduced}}</div><div class="card-label">reproduced{{template "def" "Attested at the latest version attempted."}}</div></div>
    <div class="card"><div class="card-value">{{.SuccessPct}}%</div><div class="card-label">success{{template "def" "Reproduced over attempted. A failure being retried counts against it until a retry succeeds."}}</div></div>
    <div class="card"><div class="card-value">{{.WeightedPct}}%</div><div class="card-label">weighted by score{{template "def" "Success, weighting each package by its score."}}</div></div>
</div>
{{else}}
<p>No published signals for {{.Ecosystem}}, so there is no scope to measure against.</p>
{{end}}
<h3>Campaigns{{template "def" "One campaign per package version. Done campaigns are listed under the stage that attested them."}}</h3>
{{if .HasQueue}}
<div class="cards">
    <div class="card"><div class="card-value">{{num .Queued}}</div><div class="card-label">queued{{template "def" "Campaigns waiting for dispatch at their next stage."}}</div></div>
    <div class="card"><div class="card-value">{{num .InFlight}}</div><div class="card-label">in flight{{template "def" "Campaigns dispatched and awaiting an outcome."}}</div></div>
    <div class="card"><div class="card-value">{{num .NeedsTriage}}</div><div class="card-label">needs triage{{template "def" "Campaigns whose automated stages are exhausted, awaiting a person."}}</div></div>
    {{range .DoneByStage}}<div class="card"><div class="card-value">{{num .Done}}</div><div class="card-label">done at {{.Stage}}{{if .SplitsWins}} ({{num .InferenceDone}} inference · {{num .LLMDone}} diagnosed){{template "def" "Inference: attested on the agent's iteration-1 seed strategy. Diagnosed: a later LLM-proposed iteration won."}}{{end}}</div></div>
    {{end}}
</div>
{{else}}
<p>No campaigns for {{.Ecosystem}}.</p>
{{end}}
{{if .Weeks}}
<h3>Weekly{{template "def" "Cumulative through each week over the packages attempted by then."}}</h3>
<table>
    <tr>
        <th>Week</th>
        <th>Attempted{{template "def" "Packages with an attempt by the end of the week."}}</th>
        <th>Reproduced{{template "def" "Attested at the latest version attempted by then."}}</th>
        <th>Behind{{template "def" "An earlier version is attested but not the latest."}}</th>
        <th>Share{{template "def" "Reproduced over attempted, so it moves as the queue reaches harder packages."}}</th>
        <th class="barcell"></th>
        <th>Weighted{{template "def" "Share, weighting each package by its score."}}</th>
        <th>Newly broken{{template "def" "Latest version failed that week where the previous one had built."}}</th>
    </tr>
    {{range .Weeks}}
    <tr>
        <td>{{.Week}}</td>
        <td>{{num .Attempted}}</td>
        <td>{{num .Reproduced}}</td>
        <td>{{num .Behind}}</td>
        <td>{{.SharePct}}%</td>
        <td class="barcell"><div class="bar" style="width: {{.SharePct}}%"></div></td>
        <td>{{if .HasWeighted}}{{.WeightedPct}}%{{else}}&mdash;{{end}}</td>
        <td>{{num .NewlyBroken}}</td>
    </tr>
    {{end}}
</table>
{{end}}
{{end}}
{{end}}
{{end}}
{{end}}
